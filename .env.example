# 复制本文件为 .env,三选一填好,把对应几行的注释去掉。

# --- DeepSeek(推荐:便宜、工具调用支持好)---
# 注意:旧名 deepseek-chat / deepseek-reasoner 已于 2026/07/24 废弃,请用 V4 名称:
#   deepseek-v4-flash = 便宜款(相当于原 deepseek-chat 的非思考模式)
#   deepseek-v4-pro   = 旗舰款
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-v4-flash
LLM_API_KEY=在这里填你的_deepseek_key

# 思考模式开关:设为 1 后,模型会先"思考"再回答,思考过程会打印出来。
# 想亲眼看到 reasoning 就打开它(会稍慢、稍贵)。留空则关闭。
LLM_THINKING=

# ===== 可观测(M5.2)=====
# 单价,元 / 百万 token。**请从模型厂商官网抄,不要猜。**
# 留空则不计算成本(摘要里显示"未配单价")——这是有意的:
# 区分"免费"和"不知道",一个捏造的成本数字比没有成本更糟。
# 注意区分缓存命中:实测一次请求 691 个输入 token 里有 512 个是缓存命中,
# 两者单价差很多,不区分会显著高估。
LLM_PRICE_IN=
LLM_PRICE_CACHE_IN=
LLM_PRICE_OUT=

# 观测总开关。设 0 关闭日志落盘(大批量评测时可能想关)。
OBS=1
# 是否把 prompt / 工具返回的**原文**写进日志。默认关,只记长度。
# 生产环境记录用户输入原文是事故,不是功能。排查时再临时打开。
OBS_CONTENT=

# ===== RAG(M3)=====
# ① Embedding:SiliconFlow。注意 .cn(国内版)与 .com(国际版)账号/key/模型目录互不相通!
#   - 国际版 .com:用 Qwen/Qwen3-Embedding-0.6B(1024维)/ -4B(2048)/ -8B(4096)
#   - 国内版 .cn :有 BAAI/bge-m3(1024维)
#   key 属于哪个站,base_url 就必须用哪个站,否则报 401 Token is invalid。
EMBED_BASE_URL=https://api.siliconflow.com/v1
EMBED_MODEL=Qwen/Qwen3-Embedding-0.6B
EMBED_DIM=1024
EMBED_API_KEY=在这里填你的_siliconflow_key

# ② 向量库 Qdrant(本地 docker)
QDRANT_URL=http://127.0.0.1:6333
QDRANT_COLLECTION=finance_corpus

# ③ 关系库 Postgres(本地 docker 的 newsrag 库)
PG_DSN=host=127.0.0.1 port=5432 dbname=newsrag user=postgres password=postgres

